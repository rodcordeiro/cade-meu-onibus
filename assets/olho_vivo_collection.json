              "raw": "{{baseUrl}}/Linha/Buscar?termosBusca={{termoLinha}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Linha",
                "Buscar"
              ],
              "query": [
                {
                  "key": "termosBusca",
                  "value": "{{termoLinha}}"
                }
              ]
            },
            "description": "Busca linhas por número ou nome."
          },
          "response": []
        }
      ]
    },
