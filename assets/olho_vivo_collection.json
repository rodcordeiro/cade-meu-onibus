  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// As requisições autenticadas dependem do cookie retornado por Login/Autenticar.",
          "// Se a sessão expirar, execute novamente a requisição de autenticação."
        ]
      }
    }
  ],
