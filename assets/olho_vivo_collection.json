{
  "info": {
    "name": "SPTrans Olho Vivo — Cadê Meu Ônibus",
    "_postman_id": "cbb01c16-2e2c-44f4-9270-3c2e09c94a31",
    "description": "Collection para autenticação e consultas da API SPTrans Olho Vivo v2.1. Execute 01 - Autenticação primeiro. Cookies são gerenciados pelo Postman. Não exporte variáveis preenchidas com credenciais. Documentação: https://www.sptrans.com.br/desenvolvedores/api-do-olho-vivo-guia-de-referencia/documentacao-api/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Autenticar com token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Login/Autenticar?token={{sptransToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Login",
                "Autenticar"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{sptransToken}}"
                }
              ]
            },
            "description": "Obtém uma sessão autenticada. O token é enviado como query parameter segundo o contrato da SPTrans. O Postman deve reter automaticamente os cookies Set-Cookie retornados; não compartilhe logs/URLs contendo token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Autenticação retornou true\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.eql(true);",
                  "});",
                  "// Postman armazena automaticamente o cookie de sessão do domínio.",
                  "// Execute as consultas seguintes no mesmo workspace/cliente, com cookies habilitados."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Linhas",
      "item": [
